// ParkShare data model. Conventions (docs/IMPLEMENTATION_PLAN.md §2, PRD §8):
// - UUID primary keys generated by Postgres (gen_random_uuid()).
// - Money is integer paise (`...Paise Int`) plus an explicit `currency`.
// - Every timestamp is timestamptz and is stored in UTC. Display uses Asia/Kolkata.
// - Raw SQL in migrations owns things Prisma can't express: btree_gist, the
//   generated Booking."blockedRange" column, CHECKs, and booking_no_overlap.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  RENTER
  HOST
  ADMIN
}

enum HostVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleType {
  TWO_WHEELER
  HATCHBACK
  SEDAN
  SUV
  VAN
}

enum SpaceType {
  OPEN
  COVERED
  GARAGE
  BASEMENT
  STILT
  DRIVEWAY
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum RentalType {
  HOURLY
  DAILY
  MULTI_DAY
  WEEKLY
  MONTHLY
}

/// PRD §5. Inventory-blocking states are listed in the booking_no_overlap predicate.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  GRACE_PERIOD
  OVERSTAY
  COMPLETED
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
  DISPUTED
}

enum PaymentStatus {
  ORDER_CREATED
  PENDING
  SUCCEEDED
  FAILED
  /// Captured, but the booking couldn't be confirmed (slot taken or booking cancelled): refunded.
  CAPTURED_UNFULFILLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum DisputeCategory {
  OVERSTAY
  DAMAGE
  ACCESS_DENIED
  SPACE_UNAVAILABLE
  PAYMENT
  OTHER
}

enum IncidentStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum MonthlyAgreementStatus {
  PENDING_PAYMENT
  ACTIVE
  NOTICE_GIVEN
  EXPIRED
  CANCELLED
  ENDED
}

enum SessionEventType {
  CHECK_IN
  CHECK_OUT
  EXTENDED
  REMINDER_SENT
  GRACE_STARTED
  OVERSTAY_STARTED
  NOTE
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

/// Ledger account types. Amounts are signed paise. Sum per booking to reconcile.
enum LedgerAccount {
  RENTER_PAYMENT
  PLATFORM_COMMISSION
  HOST_EARNINGS
  REFUND
  ADJUSTMENT
  HOST_PAYOUT
}

// ───────────────────── Identity (Auth.js v5 adapter) ─────────────────────

/// One account can be renter, host, and admin at once (FR-01). `roles` is the permission set.
model User {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?
  email                  String?                @unique
  emailVerified          DateTime?              @db.Timestamptz
  image                  String?
  phone                  String?                @unique
  phoneVerifiedAt        DateTime?              @db.Timestamptz
  roles                  UserRole[]             @default([RENTER])
  hostVerificationStatus HostVerificationStatus @default(NOT_STARTED)
  payoutOnboardedAt      DateTime?              @db.Timestamptz
  preferences            Json?
  deletionRequestedAt    DateTime?              @db.Timestamptz
  /// Set by admins (FR-13); suspended users can't sign in to act or book.
  suspendedAt            DateTime?              @db.Timestamptz
  suspendedReason        String?
  createdAt              DateTime               @default(now()) @db.Timestamptz
  updatedAt              DateTime               @updatedAt @db.Timestamptz

  accounts          Account[]
  sessions          Session[]
  vehicles          Vehicle[]
  listings          Listing[]
  bookings          Booking[]
  quotes            PriceQuote[]
  monthlyAgreements MonthlyAgreement[]
  payouts           HostPayout[]
  reviews           Review[]
  disputes          Dispute[]
  overstayReports   OverstayIncident[]
  notifications     Notification[]
  idempotencyKeys   IdempotencyKey[]
  reports           Report[]
}

model Account {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@unique([identifier, token])
}

model Vehicle {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @db.Uuid
  registration String
  type         VehicleType
  nickname     String?
  heightCm     Int?
  widthCm      Int?
  lengthCm     Int?
  /// Soft delete: vehicles referenced by bookings are hidden, never removed.
  deletedAt    DateTime?   @db.Timestamptz
  createdAt    DateTime    @default(now()) @db.Timestamptz
  updatedAt    DateTime    @updatedAt @db.Timestamptz

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  monthly  MonthlyAgreement[]

  @@unique([userId, registration])
}

// ───────────────────────────── Listings ─────────────────────────────

/// `address`, `lat`/`lng`, and `accessInstructions` are private: show them only to the
/// host, admins, and renters with a confirmed booking. Public views use `locality` and
/// `approxLat`/`approxLng` (rounded to about 300 m). Each price is null when the listing
/// does not offer that rental type.
model Listing {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId                String        @db.Uuid
  title                 String
  description           String
  address               String
  locality              String
  city                  String        @default("Pune")
  lat                   Float
  lng                   Float
  approxLat             Float
  approxLng             Float
  spaceType             SpaceType
  vehicleTypes          VehicleType[]
  maxHeightCm           Int?
  maxWidthCm            Int?
  maxLengthCm           Int?
  covered               Boolean       @default(false)
  lit                   Boolean       @default(false)
  evCharging            Boolean       @default(false)
  security              Boolean       @default(false)
  accessInstructions    String?
  hostRules             String?
  hourlyPaise           Int?
  dailyPaise            Int?
  weeklyPaise           Int?
  monthlyPaise          Int?
  currency              String        @default("INR")
  minDurationMinutes    Int           @default(60)
  turnoverBufferMinutes Int           @default(0)
  /// Key into the cancellation policy table in src/config/policy.ts.
  cancellationPolicy    String        @default("standard")
  hostAttestedAt        DateTime?     @db.Timestamptz
  status                ListingStatus @default(DRAFT)
  suspendedReason       String?
  createdAt             DateTime      @default(now()) @db.Timestamptz
  updatedAt             DateTime      @updatedAt @db.Timestamptz

  host              User                    @relation(fields: [hostId], references: [id])
  photos            ListingPhoto[]
  availabilityRules AvailabilityRule[]
  exceptions        AvailabilityException[]
  bookings          Booking[]
  quotes            PriceQuote[]
  monthlyAgreements MonthlyAgreement[]
  reviews           Review[]

  @@index([status, lat, lng])
  @@index([hostId])
}

model ListingPhoto {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId        String           @db.Uuid
  url              String
  /// Cloudinary public_id. The server verifies it belongs to this listing.
  publicId         String?
  position         Int              @default(0)
  moderationStatus ModerationStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

/// Recurring weekly operating hours as wall-clock time in Asia/Kolkata. `weekday` runs
/// 0 = Sunday through 6 = Saturday. Minutes are from local midnight, half-open
/// [startMinute, endMinute), with endMinute up to 1440.
model AvailabilityRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String   @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, weekday])
}

/// Date exception or blackout, [startAt, endAt) in UTC. `unavailable = false` opens
/// extra hours outside the weekly rules.
model AvailabilityException {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String   @db.Uuid
  startAt     DateTime @db.Timestamptz
  endAt       DateTime @db.Timestamptz
  unavailable Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startAt])
}

// ─────────────────────── Quotes, bookings, monthly ───────────────────────

/// Server-calculated price (FR-05). `lineItems` is the itemised breakdown and
/// `policyVersionId` pins the commission and fee rules it used.
model PriceQuote {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId         String     @db.Uuid
  renterId          String     @db.Uuid
  vehicleId         String?    @db.Uuid
  rentalType        RentalType
  startAt           DateTime   @db.Timestamptz
  endAt             DateTime   @db.Timestamptz
  lineItems         Json
  subtotalPaise     Int
  renterFeePaise    Int        @default(0)
  commissionPaise   Int
  hostEarningsPaise Int
  totalPaise        Int
  currency          String     @default("INR")
  policyVersionId   String     @db.Uuid
  expiresAt         DateTime   @db.Timestamptz
  createdAt         DateTime   @default(now()) @db.Timestamptz
  updatedAt         DateTime   @updatedAt @db.Timestamptz

  listing       Listing       @relation(fields: [listingId], references: [id])
  renter        User          @relation(fields: [renterId], references: [id])
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id])
  booking       Booking?

  @@index([renterId, createdAt])
}

/// THE inventory table. A hold is a row in PENDING_PAYMENT with `holdExpiresAt`, so no
/// separate BookingHold table exists. Each paid monthly term is also a row
/// (rentalType MONTHLY). Only the availability service writes this table. It sets
/// `blockedUntil = endAt + turnover buffer`.
/// The database enforces the rest: `blockedRange` is generated as
/// tstzrange(startAt, blockedUntil, '[)'). booking_no_overlap excludes overlapping
/// ranges per listing while the status blocks inventory. A CHECK enforces
/// endAt > startAt and blockedUntil >= endAt. The totals are a snapshot of the quote.
model Booking {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId          String                    @db.Uuid
  renterId           String                    @db.Uuid
  vehicleId          String?                   @db.Uuid
  rentalType         RentalType
  startAt            DateTime                  @db.Timestamptz
  endAt              DateTime                  @db.Timestamptz
  blockedUntil       DateTime                  @db.Timestamptz
  /// Generated column created in raw SQL. Prisma reads the generation expression as a
  /// default, so it's mirrored here to keep migrate diff empty.
  blockedRange       Unsupported("tstzrange")? @default(dbgenerated("tstzrange(\"startAt\", \"blockedUntil\", '[)'::text)"))
  status             BookingStatus             @default(PENDING_PAYMENT)
  holdExpiresAt      DateTime?                 @db.Timestamptz
  quoteId            String?                   @unique @db.Uuid
  monthlyAgreementId String?                   @db.Uuid
  hostPayoutId       String?                   @db.Uuid
  subtotalPaise      Int
  renterFeePaise     Int                       @default(0)
  commissionPaise    Int
  hostEarningsPaise  Int
  totalPaise         Int
  currency           String                    @default("INR")
  checkedInAt        DateTime?                 @db.Timestamptz
  checkedOutAt       DateTime?                 @db.Timestamptz
  cancelledAt        DateTime?                 @db.Timestamptz
  cancellationReason String?
  idempotencyKey     String?
  createdAt          DateTime                  @default(now()) @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @db.Timestamptz

  listing          Listing            @relation(fields: [listingId], references: [id])
  renter           User               @relation(fields: [renterId], references: [id])
  vehicle          Vehicle?           @relation(fields: [vehicleId], references: [id])
  quote            PriceQuote?        @relation(fields: [quoteId], references: [id])
  monthlyAgreement MonthlyAgreement?  @relation(fields: [monthlyAgreementId], references: [id])
  /// Set once the booking's host earnings are paid, so they can't be paid out twice.
  hostPayout       HostPayout?        @relation(fields: [hostPayoutId], references: [id])
  payments         Payment[]
  ledgerEntries    LedgerEntry[]
  sessionEvents    SessionEvent[]
  overstays        OverstayIncident[]
  reviews          Review[]
  disputes         Dispute[]

  @@unique([renterId, idempotencyKey])
  @@index([listingId, startAt])
  @@index([renterId, startAt])
  @@index([status, holdExpiresAt])
  @@index([monthlyAgreementId])
}

/// Monthly rental contract (FR-09). Each paid term is a Booking with rentalType MONTHLY
/// that points here. Renewal is a manual renter action and is never charged
/// automatically.
model MonthlyAgreement {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  renterId           String                 @db.Uuid
  listingId          String                 @db.Uuid
  vehicleId          String?                @db.Uuid
  monthlyPaise       Int
  currency           String                 @default("INR")
  startAt            DateTime               @db.Timestamptz
  currentTermStartAt DateTime               @db.Timestamptz
  currentTermEndAt   DateTime               @db.Timestamptz
  noticePeriodDays   Int                    @default(7)
  status             MonthlyAgreementStatus @default(PENDING_PAYMENT)
  renewalReminderAt  DateTime?              @db.Timestamptz
  renewalDueAt       DateTime?              @db.Timestamptz
  noticeGivenAt      DateTime?              @db.Timestamptz
  endedAt            DateTime?              @db.Timestamptz
  createdAt          DateTime               @default(now()) @db.Timestamptz
  updatedAt          DateTime               @updatedAt @db.Timestamptz

  renter   User      @relation(fields: [renterId], references: [id])
  listing  Listing   @relation(fields: [listingId], references: [id])
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id])
  bookings Booking[]

  @@index([listingId])
  @@index([renterId])
  @@index([status, currentTermEndAt])
}

// ─────────────────────── Payments, refunds, ledger ───────────────────────

model Payment {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId           String        @db.Uuid
  provider            String        @default("razorpay")
  providerOrderId     String        @unique
  providerPaymentId   String?       @unique
  amountPaise         Int
  currency            String        @default("INR")
  status              PaymentStatus @default(ORDER_CREATED)
  signatureVerifiedAt DateTime?     @db.Timestamptz
  failureReason       String?
  reconciledAt        DateTime?     @db.Timestamptz
  createdAt           DateTime      @default(now()) @db.Timestamptz
  updatedAt           DateTime      @updatedAt @db.Timestamptz

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@index([bookingId])
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String       @db.Uuid
  amountPaise      Int
  currency         String       @default("INR")
  reason           String
  providerRefundId String?      @unique
  status           RefundStatus @default(PENDING)
  idempotencyKey   String       @unique
  failureReason    String?
  reconciledAt     DateTime?    @db.Timestamptz
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

/// Append-only double-entry style ledger. Never update or delete rows. Corrections are
/// new ADJUSTMENT entries.
model LedgerEntry {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String?       @db.Uuid
  hostPayoutId String?       @db.Uuid
  account      LedgerAccount
  amountPaise  Int
  currency     String        @default("INR")
  /// Provider or internal reference, e.g. a payment, refund, or payout id.
  reference    String?
  memo         String?
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  booking    Booking?    @relation(fields: [bookingId], references: [id])
  hostPayout HostPayout? @relation(fields: [hostPayoutId], references: [id])

  @@index([bookingId])
  @@index([hostPayoutId])
}

model HostPayout {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId            String       @db.Uuid
  amountPaise       Int
  currency          String       @default("INR")
  status            PayoutStatus @default(PENDING)
  providerReference String?      @unique
  idempotencyKey    String       @unique
  attempts          Int          @default(0)
  failureReason     String?
  paidAt            DateTime?    @db.Timestamptz
  createdAt         DateTime     @default(now()) @db.Timestamptz
  updatedAt         DateTime     @updatedAt @db.Timestamptz

  host          User          @relation(fields: [hostId], references: [id])
  bookings      Booking[]
  ledgerEntries LedgerEntry[]

  @@index([hostId, status])
}

// ───────────────────── Sessions, incidents, trust ─────────────────────

/// Check-in, check-out, and reminder timeline for a booking. `actorId` is a plain id,
/// so the history survives account deletion.
model SessionEvent {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String           @db.Uuid
  type       SessionEventType
  actorId    String?          @db.Uuid
  occurredAt DateTime         @default(now()) @db.Timestamptz
  metadata   Json?
  createdAt  DateTime         @default(now()) @db.Timestamptz
  updatedAt  DateTime         @updatedAt @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, occurredAt])
}

model OverstayIncident {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String         @db.Uuid
  reportedById String         @db.Uuid
  reportedAt   DateTime       @default(now()) @db.Timestamptz
  evidenceUrls String[]
  status       IncidentStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?      @db.Timestamptz
  createdAt    DateTime       @default(now()) @db.Timestamptz
  updatedAt    DateTime       @updatedAt @db.Timestamptz

  booking    Booking @relation(fields: [bookingId], references: [id])
  reportedBy User    @relation(fields: [reportedById], references: [id])

  @@index([bookingId])
}

model Review {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String           @db.Uuid
  listingId        String           @db.Uuid
  authorId         String           @db.Uuid
  rating           Int
  comment          String?
  moderationStatus ModerationStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@unique([bookingId, authorId])
  @@index([listingId, moderationStatus])
}

model Dispute {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String          @db.Uuid
  raisedById   String          @db.Uuid
  category     DisputeCategory
  description  String
  evidenceUrls String[]
  status       DisputeStatus   @default(OPEN)
  resolution   String?
  resolvedById String?         @db.Uuid
  resolvedAt   DateTime?       @db.Timestamptz
  createdAt    DateTime        @default(now()) @db.Timestamptz
  updatedAt    DateTime        @updatedAt @db.Timestamptz

  booking  Booking @relation(fields: [bookingId], references: [id])
  raisedBy User    @relation(fields: [raisedById], references: [id])

  @@index([bookingId])
  @@index([status])
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String              @db.Uuid
  type           String
  channel        NotificationChannel @default(EMAIL)
  payload        Json
  scheduledAt    DateTime            @default(now()) @db.Timestamptz
  sentAt         DateTime?           @db.Timestamptz
  /// In-app read receipt (inbox unread count).
  readAt         DateTime?           @db.Timestamptz
  status         NotificationStatus  @default(PENDING)
  idempotencyKey String              @unique
  attempts       Int                 @default(0)
  lastError      String?
  createdAt      DateTime            @default(now()) @db.Timestamptz
  updatedAt      DateTime            @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// `actorId` and `targetId` are plain ids with no foreign key, so the audit trail
/// outlives the rows it describes.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

/// Durable job queue. Workers claim jobs with FOR UPDATE SKIP LOCKED where
/// status = PENDING and runAt <= now(). A job retries with backoff until maxAttempts,
/// then moves to DEAD.
model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  payload        Json
  runAt          DateTime  @default(now()) @db.Timestamptz
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lockedAt       DateTime? @db.Timestamptz
  lockedBy       String?
  lastError      String?
  status         JobStatus @default(PENDING)
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@index([status, runAt])
}

/// Immutable snapshot of src/config/policy.ts (plan §2.2). Quotes reference the version
/// they priced with.
model PolicyVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     Int      @unique
  policy      Json
  effectiveAt DateTime @default(now()) @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  quotes PriceQuote[]
}

/// Replay store for idempotent mutations. `responseJson` stays null while the first
/// request is still in flight.
model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String
  userId         String   @db.Uuid
  route          String
  requestHash    String
  responseStatus Int?
  responseJson   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, key])
}

/// Inbound webhook dedupe (FR-06). The unique (provider, eventId) pair makes duplicate
/// deliveries harmless.
model ProviderEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@unique([provider, eventId])
}

/// Fixed-window counter keyed by something like "otp:<phone>" or "ip:<addr>:<route>".
model RateLimit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  windowStart DateTime @db.Timestamptz
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@unique([key, windowStart])
}

enum ReportTargetType {
  LISTING
  REVIEW
  USER
  BOOKING
}

enum ReportReason {
  ACCESS_PROBLEM
  FAKE_OR_UNAUTHORIZED_LISTING
  INACCURATE_LISTING
  INAPPROPRIATE_CONTENT
  SUSPICIOUS_BEHAVIOR
  SAFETY
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

/// User reports of listings, reviews, users, or bookings (FR-11), moderated by admins (FR-13).
model Report {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId   String           @db.Uuid
  targetType   ReportTargetType
  targetId     String           @db.Uuid
  reason       ReportReason
  description  String
  evidenceUrls String[]
  status       ReportStatus     @default(OPEN)
  resolution   String?
  resolvedById String?          @db.Uuid
  resolvedAt   DateTime?        @db.Timestamptz
  createdAt    DateTime         @default(now()) @db.Timestamptz
  updatedAt    DateTime         @updatedAt @db.Timestamptz

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}
